# Cadena de conexión a PostgreSQL. En desarrollo local usa el Postgres que
# levanta `npx prisma dev`. En producción, la URL de tu proveedor (Railway,
# Supabase, Neon, etc.).
DATABASE_URL=

# En desarrollo local con `npx prisma dev`, DIRECT_URL y SHADOW_DATABASE_URL
# apuntan a los puertos que ese comando expone (ver la guía del proyecto).
# En producción, DIRECT_URL normalmente es la misma que DATABASE_URL, y
# SHADOW_DATABASE_URL no es necesaria (solo se usa para generar migraciones
# en desarrollo, no para aplicarlas con `prisma migrate deploy`).
DIRECT_URL=
SHADOW_DATABASE_URL=

# Secreto para firmar los JWT de sesión. Genera uno único y largo para cada
# entorno con: openssl rand -hex 32
JWT_SECRET=

# API key de Resend (resend.com) para el envío de correos de recuperación
# de contraseña. En modo sandbox (sin dominio verificado) solo puede enviar
# al email con el que te registraste en Resend.
RESEND_API_KEY=

# URL pública del frontend desplegado (Vercel). Se usa para: el link de los
# correos de recuperación de contraseña, y para restringir CORS a ese origen.
FRONTEND_URL=http://localhost:5173

# Puerto en el que corre el servidor. La mayoría de plataformas (Railway,
# Render) lo inyectan automáticamente — no suele hacer falta definirlo a mano.
PORT=4000
